<?xml version="1.0" encoding="utf-8"?>
<!--
  Sparse MSIX identity package for the Aither shell menu.

  The .msix contains this manifest and the Assets folder only. The app and the
  COM DLL stay outside it; Add-AppxPackage -ExternalLocation points at a
  directory that must contain Desk.exe (the real app, or the per-user launcher
  stub) and shell-menu\AitherShellMenu.dll. Relative paths below resolve
  against that ExternalLocation, which may be per-user (%LOCALAPPDATA%\Aither).
  See README.md for the install commands and the Microsoft docs this follows.

  Identity/@Publisher MUST equal the Subject of the certificate that signs the
  package. The CI-generated self-signed certificate uses "CN=Aither Shell Menu".
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  IgnorableNamespaces="uap uap10 rescap com desktop4 desktop5">

  <Identity
    Name="Aither.DesktopShellMenu"
    Publisher="CN=Aither Shell Menu"
    Version="1.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Aither shell menu</DisplayName>
    <PublisherDisplayName>Aitherium</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>

  <Applications>
    <Application
      Id="AitherShellMenu"
      Executable="Desk.exe"
      uap10:TrustLevel="mediumIL"
      uap10:RuntimeBehavior="win32App">

      <uap:VisualElements
        AppListEntry="none"
        DisplayName="Aither"
        Description="Capture, record, draw, take notes, or ask Aither from File Explorer."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />

      <Extensions>
        <!-- The DLL Explorer activates. Path is relative to the external location. -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="Aither shell menu">
              <com:Class
                Id="0B88D9C5-6159-41B2-88F1-2DD360C7D2AE"
                Path="shell-menu\AitherShellMenu.dll"
                ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>

        <!-- * = files, Directory = selected folders, Directory\Background =
             folder and desktop backgrounds. One CLSID serves all three. -->
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="*">
              <desktop5:Verb Id="Aither" Clsid="0B88D9C5-6159-41B2-88F1-2DD360C7D2AE" />
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="Aither" Clsid="0B88D9C5-6159-41B2-88F1-2DD360C7D2AE" />
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory\Background">
              <desktop5:Verb Id="Aither" Clsid="0B88D9C5-6159-41B2-88F1-2DD360C7D2AE" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
